# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# fal.ai (https://fal.ai/dashboard/keys) — video generation backend.
# Server-side only — never expose this to the client.
FAL_KEY=

# Comma-separated Clerk user IDs allowed to access /admin (kill switch,
# live/test mode toggle, generation audit log).
ADMIN_USER_IDS=

# Test mode (mocked, no real fal.ai calls) is blocked in production unless
# this is explicitly set to "true". Leave unset/false in production.
ALLOW_TEST_MODE_IN_PRODUCTION=

# Admin email notifications, sent on every successful subscription.
# Resend (https://resend.com/api-keys) — server-side only, never exposed
# to the client. MAIL_FROM_EMAIL must be a verified sender/domain in Resend.
RESEND_API_KEY=
MAIL_FROM_EMAIL=
ADMIN_EMAIL=

# Gumroad (real payment provider). Settings -> Advanced -> Applications on
# gumroad.com — used server-side only, to verify each Ping webhook's sale
# with Gumroad's API before granting credits. Never exposed to the client.
GUMROAD_ACCESS_TOKEN=
